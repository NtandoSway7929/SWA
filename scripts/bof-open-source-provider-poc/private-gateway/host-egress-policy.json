    "host_specific_ranges_required": true,
    "host_specific_ranges": [],
    "host_specific_required_inputs": [
      "host LAN and management interface address ranges",
      "VPN and office address ranges, including routes not currently active",
      "all existing Docker bridge, overlay and other container network ranges",
      "cloud-provider metadata and control-plane destination ranges",
      "any other private or reserved ranges routed inside the selected host environment"
    ],
    "note": "The baseline is deliberately conservative and incomplete. It is not a generated or exhaustive copy of the live IANA registries. Populate and review host-specific ranges before enforcement."
  },
  "ipv6": {
    "filtering_required": true,
    "required_coverage": "filter forwarded IPv6 egress, or independently prove that no IPv6 forwarded path exists",
    "forwarding_audit_required": true,
    "must_not_assume_disabled_forwarding_alone_proves_no_path": true
  },
  "dns": {
    "docker_embedded_resolver_path": "inspect and document on the selected host before enforcement",
    "direct_external_dns_from_provider_containers": "deny unless a specific resolver IP and required protocol/port are explicitly approved",
    "arbitrary_dns_egress": "deny",
    "note": "Do not add broad UDP/TCP 53 allowances as a troubleshooting shortcut. Egress destination filtering must still apply after resolution."
  },
  "backend_attachments": {
    "iptables": {
      "attachment": "administrator-owned chain reached from DOCKER-USER in the filter/FORWARD path",
      "preserve_existing_chain": true,
      "do_not_flush_or_replace_docker_user": true,
      "policy_must_precede_docker_forward_accepts": true
    },
    "nftables": {
      "attachment": "separate administrator-owned table with a forward base chain",
      "example_table": "inet swayphics_bof",
      "policy_must_precede_docker_forward_accepts": true,
      "do_not_create_docker_user": true,
      "do_not_modify_docker_managed_tables": true
    }
  },
  "host_preflight_required": [
    "identify Docker firewall backend from the daemon",
    "audit host interfaces, all non-default IPv4 and IPv6 routes, Docker IPAM and external VPN/cloud allocations",
    "capture IPv4 and IPv6 forwarding state and complete active firewall ruleset",
    "confirm the actual Docker DNS resolver path",
    "refresh Cloudflare Tunnel regional endpoint addresses and confirm host firewall support for a maintained destination set",
    "design a rollback path that does not depend on the affected SSH/network path"
  ],
