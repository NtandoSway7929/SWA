  "default_policy": {
    "new_outbound_connections": "deny",
    "unsolicited_inbound_connections": "deny",
    "established_return": {
      "action": "allow",
      "conntrack_states": [
        "ESTABLISHED",
        "RELATED"
      ],
      "direction": "responses-to-connections-originated-by-egress-services-only",
      "destination_scope": "the-three-egress-source-subnets-only"
    },
    "unrelated_host_and_docker_traffic": "unchanged"
  },
  "evaluation": {
    "new_egress_order": [
      "deny baseline non-public and host-specific internal destinations",
      "allow only the matching source service ports and approved destination scope",
      "deny all remaining new outbound connections from the three egress source subnets"
    ],
    "return_path": "allow only ESTABLISHED or RELATED responses to connections initiated by the three egress source subnets",
    "destination_denials_precede_service_port_allows": true
  },
  "destination_denials": {
    "evaluation_target": "destination address after the connection has resolved to an IP address",
    "ipv4_baseline": [
