# Copy outside the repository for a real deployment; protect it with mode 0600.
# Keep all secrets out of Git, browser code, request bodies and logs.

SEARXNG_SECRET=
CRAWL4AI_API_TOKEN=

# Proposed hostname only. Do not create the DNS route until the Access app is active.
BOF_GATEWAY_PUBLIC_URL=https://bof-inspect.swayphics.co.za

# Each image reference MUST be an audited immutable reference:
# registry/name:version@sha256:<full-64-character-manifest-digest>
CADDY_IMAGE=
VALKEY_IMAGE=
CLOUDFLARED_IMAGE=

# Put the remotely-managed Cloudflare Tunnel token in a separate mode-0600 file.
# This is the tunnel connector token, NOT the Cloudflare Access service token.
CLOUDFLARED_TUNNEL_TOKEN_FILE=/etc/swayphics-bof/cloudflare-tunnel-token
